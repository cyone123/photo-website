# PostgreSQL / Neon
DATABASE_URL=

# Better Auth (required for /admin)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional default used by `pnpm admin:init` when --email is omitted.
ADMIN_EMAIL=

# Cloudflare R2 (used by the local photo CLI)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional: notify a deployed site to refresh its gallery cache after imports.
# Use the full endpoint URL, for example https://photos.example.com/api/revalidate.
SITE_REVALIDATE_URL=
REVALIDATE_SECRET=
