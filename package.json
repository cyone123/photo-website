{
  "name": "photo-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "photo": "tsx src/cli/index.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.34.1",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@neondatabase/serverless": "^1.1.0",
    "blurhash": "^2.0.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
